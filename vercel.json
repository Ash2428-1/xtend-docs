{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "apps/remix/build/client",
  "regions": ["dub1"],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "{apps/remix/build/server/**,packages/lib/translations/**,packages/assets/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
